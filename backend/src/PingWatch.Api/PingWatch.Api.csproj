<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <!-- Lets "dotnet user-secrets" keep the local JWT signing key outside the repository. -->
    <UserSecretsId>pingwatch-api-dev</UserSecretsId>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="9.0.23" />
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="9.0.23" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="9.0.23">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\PingWatch.Infrastructure\PingWatch.Infrastructure.csproj" />
  </ItemGroup>
</Project>